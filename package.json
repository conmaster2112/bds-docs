{
  "name": "bds-docs",
  "version": "1.0.0",
  "description": "Releasing BDS Docs",
  "homepage": "https://github.com/Bedrock-APIs/bds-docs#readme",
  "bugs": {
    "url": "https://github.com/Bedrock-APIs/bds-docs/issues"
  },
  "license": "MIT",
  "author": "conmaster2112",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bedrock-APIs/bds-docs.git"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "rolldown -c",
    "check": "tsgo --noEmit"
  },
  "dependencies": {
    "@bedrock-apis/bds-utils": "1.0.0-alpha.6",
    "@minecraft/server": "2.1.0-beta.1.21.90-preview.23",
    "@minecraft/server-net": "1.0.0-beta.1.21.90-preview.23",
    "@minecraft/server-ui": "2.1.0-beta.1.21.90-preview.23",
    "unzip-web-stream": "0.0.0-alpha.1"
  },
  "devDependencies": {
    "@types/deno": "^2.5.0",
    "@types/node": "^25.5.2",
    "@typescript/native-preview": "7.0.0-dev.20250803.1",
    "prettier": "^3.5.3",
    "rolldown": "1.0.0-beta.47"
  },
  "prettier": {
    "arrowParens": "avoid",
    "endOfLine": "crlf",
    "plugins": [
      "prettier-plugin-jsdoc"
    ],
    "printWidth": 120,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 3
  }
}
